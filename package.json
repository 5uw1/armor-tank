{
  "name": "armor-tank",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "app:win": "vite build && electron-builder --win -c.electronDist=node_modules/electron/dist",
    "app:win:dev": "vite build && electron .",
    "app:android": "vite build && cap sync android && cd android && gradlew assembleDebug",
    "app:android:release": "vite build && cap sync android && cd android && gradlew bundleRelease assembleRelease",
    "app:ios": "vite build && cap sync ios",
    "icons": "node scripts/make-icons.mjs && capacitor-assets generate --android --ios --iconBackgroundColor \"#15171a\" --splashBackgroundColor \"#15171a\"",
    "app:mac": "vite build && electron-builder --mac",
    "app:linux": "vite build && electron-builder --linux"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@types/three": "^0.186.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "main": "electron/main.cjs",
  "description": "Armor Tank — 2.5D tank battle game",
  "author": {
    "name": "5uw1",
    "email": "5uw1@users.noreply.github.com"
  },
  "build": {
    "appId": "com.armortank.game",
    "productName": "Armor Tank",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Armor Tank"
    },
    "portable": {
      "artifactName": "ArmorTank-portable-${version}.exe"
    },
    "npmRebuild": false,
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.action-games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "ArmorTank-${version}-mac.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Game",
      "maintainer": "5uw1 <5uw1@users.noreply.github.com>",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "homepage": "https://github.com/5uw1/armor-tank"
}
